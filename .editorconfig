# ─────────────────────────────────────────────────────────────
# BeatMorph — EditorConfig
# 各编辑器/IDE 统一基础格式（与 .gitattributes 配合保证跨设备一致）
# ─────────────────────────────────────────────────────────────

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,toml}]
indent_size = 4

[*.{md,yaml,yml,json,jsonc}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab

[*.{osu,sm,ma2}]
end_of_line = lf
indent_size = 2
trim_trailing_whitespace = false

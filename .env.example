# BeatMorph 环境变量样例
# 复制为 .env 并填入实际值（.env 已被 .gitignore 忽略，切勿提交真实密钥）

# ── 数据与产物路径（见 configs/data/*.yaml、Plan 08/09）──
BEATMORPH_DATA_DIR=data
BEATMORPH_RUNS_DIR=runs
BEATMORPH_CACHE_DIR=.cache

# ── 模型权重根目录（预训练 MERT 等，不入库）──
BEATMORPH_MODELS_DIR=models/pretrained

# ── 实验追踪（Plan 09）──
WANDB_PROJECT=beatmorph
WANDB_ENTITY=
# WANDB_API_KEY=<your-key>

# ── HuggingFace（下载 MERT-v1-330M 等）──
# HF_TOKEN=<your-token>
HF_HOME=.cache/huggingface

# ── 训练硬件（PyTorch Lightning，Plan 09）──
# CUDA 可见设备，多个用逗号分隔
CUDA_VISIBLE_DEVICES=0

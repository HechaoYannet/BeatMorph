# ─────────────────────────────────────────────────────────────
# BeatMorph — .gitattributes
# 统一换行符、二进制识别、Git LFS 大文件管理
# ─────────────────────────────────────────────────────────────

# 默认对所有文本文件统一 LF 换行（跨设备协作关键）
* text=auto eol=lf

# 明确的文本类型
*.py     text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.txt    text eol=lf
*.sh     text eol=lf
*.osu   text eol=lf
*.sm    text eol=lf
*.ma2   text eol=lf

# Windows 脚本保留 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# 二进制文件（不做换行转换）
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.zip    binary
*.tar    binary
*.gz     binary
*.7z     binary

# ── Git LFS：模型权重与数据走 LFS ──
# 已启用 git lfs install。大文件二进制经 LFS 存储（免费配额 1GB 存储/1GB 月带宽，
# 仅推小型 dev_sample，全量产物各设备自行提取，见 docs/TRAINING.md）。
*.ckpt        filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pt          filter=lfs diff=lfs merge=lfs -text
*.pth         filter=lfs diff=lfs merge=lfs -text
*.onnx        filter=lfs diff=lfs merge=lfs -text
*.parquet     filter=lfs diff=lfs merge=lfs -text
*.arrow       filter=lfs diff=lfs merge=lfs -text

# 语言统计：让 GitHub 正确识别 .osu/.sm/.ma2 谱面文件
*.osu  linguist-language=INI
*.sm   linguist-language=INI
*.ma2  linguist-language=INI

# 将数据/权重目录排除出语言统计
data/** linguist-vendored
models/** linguist-vendored
